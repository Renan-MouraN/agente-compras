# Copie para .env e preencha. O arquivo .env NÃO é versionado (.gitignore).
#   cp .env.example .env

# --- Obrigatório -----------------------------------------------------------
# Chave da OpenRouter (https://openrouter.ai/keys). Sem ela o stack sobe,
# mas o chat responde que a chave não está configurada.
OPENROUTER_API_KEY=

# --- Opcional (valores padrão entre parênteses) ----------------------------
# Modelo usado pelo agente; precisa suportar tool calling. (anthropic/claude-haiku-5.5)
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Timeout de cada chamada ao LLM, em segundos. (60)
# OPENROUTER_TIMEOUT_SECONDS=60
# Máximo de rodadas LLM <-> ferramentas por pedido. (10)
# AGENT_MAX_STEPS=10

# API de produtos e timeout por chamada, em segundos. (https://dummyjson.com / 10)
# Dica: aponte para um IP que não responde (ex.: http://10.255.255.1) para
# ver o tratamento de timeout no chat.
# DUMMYJSON_BASE_URL=https://dummyjson.com
# DUMMYJSON_TIMEOUT_SECONDS=10

# Credenciais do Postgres local (o banco não é exposto fora da rede do compose).
# POSTGRES_DB=compras
# POSTGRES_USER=compras
# POSTGRES_PASSWORD=compras

# Portas publicadas no host. (3000 / 8000 / 8001)
# FRONTEND_PUBLISHED_PORT=3000
# BACKEND_PUBLISHED_PORT=8000
# MCP_PUBLISHED_PORT=8001
